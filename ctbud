# content_agent.py
import json
import os
import sys
from pathlib import Path

import requests
from openai import OpenAI

client = OpenAI()  # Reads OPENAI_API_KEY from the environment

SCHEMA = {
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "blog": {"type": "string"},
        "image_search_terms": {
            "type": "array",
            "items": {"type": "string"},
        },
        "social_posts": {
            "type": "array",
            "items": {"type": "string"},
        },
    },
    "required": ["title", "blog", "image_search_terms", "social_posts"],
    "additionalProperties": False,
}

def create_content(transcript: str) -> dict:
    response = client.responses.create(
        model=os.getenv("OPENAI_MODEL", "gpt-5-mini"),
        input=f"""
Turn this transcript into:
- One clear, useful blog post. Don't invent facts or quotes.
- Exactly three concise social posts based only on the transcript.
- Three short stock-image search phrases relevant to the content.

Return the result in the required JSON format.

TRANSCRIPT:
{transcript}
""",
        text={
            "format": {
                "type": "json_schema",
                "name": "content_package",
                "strict": True,
                "schema": SCHEMA,
            }
        },
    )
    return json.loads(response.output_text)

def find_unsplash_images(terms: list[str]) -> list[dict]:
    """Optional: requires an Unsplash API access key."""
    key = os.getenv("UNSPLASH_ACCESS_KEY")
    if not key:
        return []

    images = []
    for term in terms:
        result = requests.get(
            "https://api.unsplash.com/search/photos",
            params={"query": term, "per_page": 3},
            headers={"Authorization": f"Client-ID {key}"},
            timeout=20,
        )
        result.raise_for_status()

        for photo in result.json().get("results", []):
            images.append({
                "search_term": term,
                "description": photo.get("alt_description"),
                "image_url": photo["urls"]["regular"],
                "photo_page": photo["links"]["html"],
                "photographer": photo["user"]["name"],
            })
    return images

def main():
    if len(sys.argv) != 2:
        raise SystemExit("Usage: python content_agent.py transcript.txt")

    transcript = Path(sys.argv[1]).read_text(encoding="utf-8")
    package = create_content(transcript)
    package["image_options"] = find_unsplash_images(
        package["image_search_terms"]
    )

    out = Path("content_review")
    out.mkdir(exist_ok=True)
    (out / "content.json").write_text(
        json.dumps(package, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )

    # Convenient readable draft for review
    markdown = f"# {package['title']}\n\n{package['blog']}\n\n"
    markdown += "## Social drafts\n\n"
    markdown += "\n\n".join(
        f"{i}. {post}"
        for i, post in enumerate(package["social_posts"], 1)
    )
    (out / "drafts.md").write_text(markdown, encoding="utf-8")

    print("Drafts saved in content_review/. Review them before publishing.")
    if package["image_options"]:
        print(f"Found {len(package['image_options'])} image options.")
    else:
        print("No image search ran; set UNSPLASH_ACCESS_KEY to enable it.")

if __name__ == "__main__":
    main()


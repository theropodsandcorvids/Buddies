Save this as `/opt/pi-rag-gateway/app.py`:

```python
import logging
import os
from pathlib import Path

import requests
from dotenv import load_dotenv
from flask import Flask, Response, jsonify, render_template, request, stream_with_context

load_dotenv(Path(__file__).with_name(".env"))

MAC_BASE_URL = os.environ["MAC_BASE_URL"].rstrip("/")
RAG_API_KEY = os.environ["RAG_API_KEY"]

app = Flask(__name__)


def mac_headers():
    return {"Authorization": f"Bearer {RAG_API_KEY}"}


@app.get("/")
def index():
    return render_template("index.html")


@app.get("/health")
def health():
    return jsonify({"status": "ok"})


@app.post("/chat")
def chat():
    data = request.get_json(silent=True) or {}
    message = data.get("message")
    session_id = data.get("session_id")

    if not isinstance(message, str) or not message.strip() or len(message) > 4000:
        return jsonify({"error": "Enter a question up to 4000 characters."}), 400
    if not isinstance(session_id, str) or len(session_id) > 64:
        return jsonify({"error": "Invalid session."}), 400

    def stream():
        try:
            with requests.post(
                f"{MAC_BASE_URL}/ask",
                headers=mac_headers(),
                json={"prompt": message.strip(), "session_id": session_id},
                stream=True,
                timeout=(5, 900),
            ) as upstream:
                upstream.raise_for_status()
                for chunk in upstream.iter_content(chunk_size=None):
                    if chunk:
                        yield chunk
        except Exception:
            logging.exception("Mac RAG request failed")
            yield b"\n\n[Could not reach the Mac RAG service.]"

    return Response(
        stream_with_context(stream()),
        content_type="text/plain; charset=utf-8",
    )


@app.post("/clear")
def clear():
    data = request.get_json(silent=True) or {}
    session_id = data.get("session_id")

    try:
        upstream = requests.post(
            f"{MAC_BASE_URL}/clear",
            headers=mac_headers(),
            json={"session_id": session_id},
            timeout=(5, 15),
        )
        upstream.raise_for_status()
        return jsonify({"status": "ok"})
    except Exception:
        logging.exception("Clear request failed")
        return jsonify({"error": "Could not clear this session."}), 502


@app.post("/refresh")
def refresh():
    try:
        upstream = requests.post(
            f"{MAC_BASE_URL}/refresh",
            headers=mac_headers(),
            timeout=(5, 900),
        )
        upstream.raise_for_status()
        return jsonify(upstream.json())
    except Exception:
        logging.exception("Index refresh failed")
        return jsonify({"error": "Index refresh failed. Check service logs."}), 502
```

Save this as `/opt/pi-rag-gateway/templates/index.html`:

```html
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Local Document Assistant</title>
  <style>
    body {
      font: 16px system-ui, sans-serif;
      max-width: 760px;
      margin: 32px auto;
      padding: 0 16px;
      background: #f4f4f9;
    }
    .bar, .input { display: flex; gap: 8px; }
    .bar { justify-content: space-between; align-items: center; }
    #chat {
      background: white;
      border: 1px solid #ddd;
      border-radius: 8px;
      height: 65vh;
      min-height: 320px;
      overflow-y: auto;
      padding: 14px;
      margin: 14px 0;
    }
    .message { white-space: pre-wrap; margin: 0 0 12px; line-height: 1.5; }
    .user { color: #0056b3; font-weight: bold; }
    .assistant { color: #2e7d32; font-weight: bold; }
    input { flex: 1; min-width: 0; padding: 10px; }
    button { padding: 10px 14px; cursor: pointer; }
    button:disabled { cursor: not-allowed; opacity: .6; }
  </style>
</head>
<body>
  <div class="bar">
    <h2>Local Document Assistant</h2>
    <div>
      <button id="clear">Clear chat</button>
      <button id="refresh">Refresh index</button>
    </div>
  </div>

  <div id="chat" aria-live="polite"></div>

  <form id="form" class="input">
    <input id="prompt" maxlength="4000" autocomplete="off"
           placeholder="Ask about your documents..." required>
    <button id="send">Send</button>
  </form>

  <script>
    const chat = document.getElementById("chat");
    const form = document.getElementById("form");
    const promptInput = document.getElementById("prompt");
    const sendButton = document.getElementById("send");
    const sessionKey = "local-rag-session";

    let sessionId = localStorage.getItem(sessionKey);
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      localStorage.setItem(sessionKey, sessionId);
    }

    function addMessage(label, text, className) {
      const div = document.createElement("div");
      div.className = "message";
      const prefix = document.createElement("span");
      prefix.className = className;
      prefix.textContent = label + ": ";
      div.appendChild(prefix);
      div.appendChild(document.createTextNode(text));
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = promptInput.value.trim();
      if (!message) return;

      addMessage("You", message, "user");
      promptInput.value = "";
      sendButton.disabled = true;

      const answerDiv = addMessage("Assistant", "", "assistant");
      const answerPrefix = answerDiv.firstChild;

      try {
        const response = await fetch("/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message, session_id: sessionId }),
        });

        if (!response.ok) {
          throw new Error("Request failed (" + response.status + ")");
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          answerPrefix.after(document.createTextNode(decoder.decode(value, {stream: true})));
          chat.scrollTop = chat.scrollHeight;
        }

        const remaining = decoder.decode();
        if (remaining) answerDiv.appendChild(document.createTextNode(remaining));
      } catch (error) {
        answerDiv.appendChild(
          document.createTextNode("Could not reach the RAG service.")
        );
      } finally {
        sendButton.disabled = false;
        promptInput.focus();
      }
    });

    document.getElementById("clear").addEventListener("click", async () => {
      try {
        const response = await fetch("/clear", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ session_id: sessionId }),
        });
        if (!response.ok) throw new Error("Clear failed");
        chat.replaceChildren();
        addMessage("System", "This session's conversation memory was cleared.", "");
      } catch {
        addMessage("System", "Could not clear the session.", "");
      }
    });

    document.getElementById("refresh").addEventListener("click", async (event) => {
      const button = event.currentTarget;
      button.disabled = true;
      try {
        const response = await fetch("/refresh", { method: "POST" });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Refresh failed");
        addMessage(
          "System",
          `Index refreshed. Loaded ${data.loaded_documents} documents.`,
          ""
        );
      } catch {
        addMessage("System", "Index refresh failed. Check the service logs.", "");
      } finally {
        button.disabled = false;
      }
    });
  </script>
</body>
</html>
```

The interface uses text nodes for answers and status messages instead of treating model output or API responses as HTML.


import logging
import os
from pathlib import Path

import requests
from dotenv import load_dotenv
from flask import Flask, Response, jsonify, render_template, request, stream_with_context

load_dotenv(Path(__file__).with_name(".env"))

MAC_BASE_URL = os.environ["MAC_BASE_URL"].rstrip("/")
API_KEY = os.environ["RAG_API_KEY"]

app = Flask(__name__)


def mac_headers():
    return {"Authorization": f"Bearer {API_KEY}"}


@app.get("/")
def index():
    return render_template("index.html")


@app.post("/chat")
def chat():
    data = request.get_json(silent=True) or {}
    message = data.get("message")
    session_id = data.get("session_id")

    if not isinstance(message, str) or not message.strip() or len(message) > 4000:
        return jsonify({"error": "Enter a question up to 4000 characters."}), 400
    if not isinstance(session_id, str) or len(session_id) > 64:
        return jsonify({"error": "Invalid session."}), 400

    def stream():
        try:
            with requests.post(
                f"{MAC_BASE_URL}/ask",
                headers=mac_headers(),
                json={"prompt": message.strip(), "session_id": session_id},
                stream=True,
                timeout=(5, 900),
            ) as upstream:
                upstream.raise_for_status()
                for chunk in upstream.iter_content(chunk_size=None):
                    if chunk:
                        yield chunk
        except Exception:
            logging.exception("Mac RAG request failed")
            yield b"\n\n[Could not reach the Mac RAG service.]"

    return Response(
        stream_with_context(stream()),
        content_type="text/plain; charset=utf-8",
    )


@app.post("/clear")
def clear():
    data = request.get_json(silent=True) or {}
    session_id = data.get("session_id")

    try:
        response = requests.post(
            f"{MAC_BASE_URL}/clear",
            headers=mac_headers(),
            json={"session_id": session_id},
            timeout=(5, 15),
        )
        response.raise_for_status()
        return jsonify({"status": "ok"})
    except Exception:
        logging.exception("Clear request failed")
        return jsonify({"error": "Could not clear this session."}), 502


@app.post("/refresh")
def refresh():
    try:
        response = requests.post(
            f"{MAC_BASE_URL}/refresh",
            headers=mac_headers(),
            timeout=(5, 900),
        )
        response.raise_for_status()
        return jsonify(response.json())
    except Exception:
        logging.exception("Index refresh failed")
        return jsonify({"error": "Index refresh failed. Check service logs."}), 502
```


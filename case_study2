### Run the Mac service at login

Create `~/mac-rag-server/run_server.sh`:

```bash
#!/bin/bash
set -e

cd "$HOME/mac-rag-server"

# Wait for the Ollama app/API to start after login.
for i in {1..60}; do
  if curl -fsS http://127.0.0.1:11434/api/tags >/dev/null; then
    break
  fi
  sleep 5
done

curl -fsS http://127.0.0.1:11434/api/tags >/dev/null
exec "$HOME/mac-rag-server/venv/bin/python" "$HOME/mac-rag-server/server.py"
```

```bash
chmod 700 ~/mac-rag-server/run_server.sh
mkdir -p ~/Library/LaunchAgents
```

